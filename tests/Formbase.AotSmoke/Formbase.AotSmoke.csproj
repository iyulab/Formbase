<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Publishes Formbase as a Native AOT executable and runs it. The packages' analyzers (IsAotCompatible)
    see Formbase's own code at build time; only a real AOT publish sees the whole graph a host compiles,
    dependencies included, and only running the result proves the reflection-free paths work. Not a
    test project: `dotnet test` does not run it; CI publishes and executes it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The AOT compiler package comes with the SDK at the runtime patch the SDK was cut with. 10.0.13 carries
    GHSA-p3jp-9v83-76w9 (Brotli decoder out-of-bounds write); raising the pack version here takes the fixed patch
    without waiting for an SDK that bundles it. Drop this once the SDK in use is at 10.0.14 or later.
  -->
  <ItemGroup>
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" ILCompilerPackVersion="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Formbase.Core\Formbase.Core.csproj" />
    <ProjectReference Include="..\..\src\Formbase.Sqlite\Formbase.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Formbase.MorphDb\Formbase.MorphDb.csproj" />
    <ProjectReference Include="..\..\src\Formbase.DependencyInjection\Formbase.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Formbase.Formdown\Formbase.Formdown.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
