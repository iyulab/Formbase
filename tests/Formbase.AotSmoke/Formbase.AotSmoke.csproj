<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Publishes Formbase as a Native AOT executable and runs it. The packages' analyzers (IsAotCompatible)
    see Formbase's own code at build time; only a real AOT publish sees the whole graph a host compiles,
    dependencies included, and only running the result proves the reflection-free paths work. Not a
    test project: `dotnet test` does not run it; CI publishes and executes it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Formbase.Core\Formbase.Core.csproj" />
    <ProjectReference Include="..\..\src\Formbase.Sqlite\Formbase.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Formbase.DependencyInjection\Formbase.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
