<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Formbase.Host</RootNamespace>
    <!--
      The host is a deployable, not a library. The rest of the repo ships as packages and stays
      that way: a consumer that embeds the engine must keep being able to, so this project is the
      packaging of the surface rather than a replacement for it.
    -->
    <IsPackable>false</IsPackable>
    <!-- Not a package, so no API documentation file (src/Directory.Build.props). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Formbase.Core\Formbase.Core.csproj" />
    <ProjectReference Include="..\Formbase.DependencyInjection\Formbase.DependencyInjection.csproj" />
    <ProjectReference Include="..\Formbase.MorphDb\Formbase.MorphDb.csproj" />
    <ProjectReference Include="..\Formbase.Postgres\Formbase.Postgres.csproj" />
    <ProjectReference Include="..\Formbase.SchemaIntelligence\Formbase.SchemaIntelligence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Formbase.Host.Tests" />
  </ItemGroup>

</Project>
