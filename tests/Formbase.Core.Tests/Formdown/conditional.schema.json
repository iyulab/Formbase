      }
    ],
    "htmlAttributes": {
      "form": "formdown-form-default"
    },
    "layout": "vertical",
    "group": "formdown-group-조치",
    "conditions": {
      "visibleIf": {
        "field": "result",
        "operator": "=",
        "value": "fail"
      }
    }
  },
  "note": {
    "type": "textarea",
    "label": "Note",
    "position": 6,
    "htmlAttributes": {
      "form": "formdown-form-default"
    },
    "layout": "vertical",
    "group": "formdown-group-조치"
