## [검사]
@lot_no(로트 번호)*: [text maxlength=50]
@inspected_on*: [date]
@qty: [number min=0]
@unit_price: [number step=0.01]
@total: [number compute="qty * unit_price"]
@passed: [checkbox]
@result: [radio options="pass=합격,fail=불합격"]
@defects: [checkbox options="scratch,dent,stain"]
@grade: [select options="A,B,C" allow-other]
@note: [textarea]
@shift_start: [time]
@photo: [file accept="image/*"]
@lotCode: [text pattern="^[A-Z]{2}-\d+$"]
@supplier -> Suppliers: [text]
@send: [submit]
